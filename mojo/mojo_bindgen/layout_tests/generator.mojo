"""Generate stable-toolchain runtime checks from source record geometry."""
from std.memory import ArcPointer
from ..ir import *
from ..analysis.facts.record_layout import analyze_record_layout
from ..analysis.mojo.mapping_support import field_mojo_name, record_name


@fieldwise_init
struct LayoutCheck(Copyable, Movable):
    var label: String
    var expression: String
    var expected: Int


@fieldwise_init
struct LayoutRecordCheck(Copyable, Movable):
    var record_name: String
    var checks: List[LayoutCheck]


def collect_layout_record_checks(unit: Unit, module: MojoModule) raises -> List[LayoutRecordCheck]:
    var records = Dict[String, StructDecl]()
    for decl in module.decls:
        match decl:
            case .struct_decl(v):
                records[v.name] = v.copy()
            case _:
                pass
    var result = List[LayoutRecordCheck]()
    for decl in unit.decls:
        match decl:
            case .struct_decl(v):
                if v.is_union or not v.is_complete:
                    continue
                var name = record_name(v)
                if name not in records:
                    continue
                var target = records[name].copy()
                if target.kind != StructKind.PLAIN:
                    continue
                var facts = analyze_record_layout(v)
                if not facts.is_complete:
                    continue
                var checks = List[LayoutCheck]()
                checks.append(
                    LayoutCheck(name + ".size", "size_of[" + name + "]()", facts.size_bytes)
                )
                if facts.align_bytes:
                    checks.append(
                        LayoutCheck(
                            name + ".align", "align_of[" + name + "]()", facts.align_bytes.value()
                        )
                    )
                var opaque = False
                if len(target.members) == 1:
                    match target.members[0]:
                        case .opaque_storage_member(_):
                            opaque = True
                        case _:
                            pass
                if not opaque:
                    var indices = Dict[String, Int]()
                    for i in range(len(target.members)):
                        match target.members[i]:
                            case .stored_member(m):
                                indices[m.name] = i
                            case .bitfield_group_member(m):
                                indices[m.storage_name] = i
                            case .opaque_storage_member(m):
                                indices[m.name] = i
                            case .padding_member(m):
                                indices[m.name] = i
                    for field in facts.plain_fields:
                        var member = field_mojo_name(v.fields[field.index], field.index)
                        if member in indices:
                            checks.append(
                                LayoutCheck(
                                    name + "." + member + ".offset",
                                    "r.field_offset[index=" + String(indices[member]) + "]()",
                                    field.byte_offset,
                                )
                            )
                    for run in facts.bitfield_runs:
                        if run.name in indices:
                            checks.append(
                                LayoutCheck(
                                    name + "." + run.name + ".offset",
                                    "r.field_offset[index=" + String(indices[run.name]) + "]()",
                                    run.byte_offset,
                                )
                            )
                result.append(LayoutRecordCheck(name^, checks^))
            case _:
                pass
    return result^


def render_layout_test_module(
    normalized_unit: Unit, mojo_module: MojoModule, main_module_name: String
) raises -> String:
    var records = collect_layout_record_checks(normalized_unit, mojo_module)
    var lines = List[String]()
    lines.append("# Generated by mojo_bindgen - do not edit by hand.")
    lines.append("# layout tests for: " + main_module_name)
    lines.append("")
    lines.append("from std.testing import TestSuite")
    lines.append("from std.sys.info import align_of, size_of")
    lines.append("from std.reflection import reflect")
    if records:
        var names = List[String]()
        for record in records:
            names.append(record.record_name)
        lines.append("from " + main_module_name + " import " + ", ".join(names))
    lines.append("")
    lines.append("")
    lines.append("def _check_eq(label: String, got: Int, expected: Int) raises:")
    lines.append("    if got != expected:")
    lines.append(
        '        raise Error(label + ": got " + String(got) + ", expected " + String(expected))'
    )
    for record in records:
        lines.append("")
        lines.append("")
        lines.append("def test_layout_" + record.record_name + "() raises:")
        lines.append("    comptime r = reflect[" + record.record_name + "]")
        for check in record.checks:
            lines.append(
                '    _check_eq("'
                + check.label
                + '", Int('
                + check.expression
                + "), "
                + String(check.expected)
                + ")"
            )
        if not record.checks:
            lines.append("    pass")
    lines.append("")
    lines.append("")
    lines.append("def main() raises:")
    lines.append("    TestSuite.discover_tests[__functions_in_module()]().run()")
    return "\n".join(lines) + "\n"
